# Copy to .env — the server reads it; keys never reach the browser.
# Gemini is used when GEMINI_API_KEY is set (get one at https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Optional alternative provider. Used only if GEMINI_API_KEY is empty
# (or if VERDICT_PROVIDER=claude).
ANTHROPIC_API_KEY=

# Optional overrides
# VERDICT_PROVIDER=gemini        # gemini | claude | offline
# VERDICT_GEMINI_MODEL=          # skip auto-discovery and pin a model, e.g. gemini-2.5-pro
# VERDICT_MODEL=claude-opus-5    # Claude model
